# OpenAI-compatible settings
OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini

# Optional defaults
DEFAULT_PLATFORM=mastodon
DEFAULT_COUNT=10

# Mastodon posting (required only if using --publish)
# Example: https://mastodon.social
MASTODON_BASE_URL=
# Create an access token from your Mastodon instance (Preferences -> Development)
MASTODON_ACCESS_TOKEN=
# public | unlisted | private | direct
MASTODON_VISIBILITY=public

# Replicate (Flux fine-tune) image generation (optional)
# Get a token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Use EITHER a model version hash OR owner/name
# Example version: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
REPLICATE_MODEL_VERSION=
# Example model: your-username/your-flux-finetune
REPLICATE_MODEL=

# Telegram approval gate (optional; used with --require-telegram-approval)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds to wait for approval per post
TELEGRAM_APPROVAL_TIMEOUT_S=900
